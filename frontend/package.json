{
  "name": "grupo-patrimonial-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:rendal": "npm run dev --workspace @grupo-patrimonial/rendal -- --port 3001",
    "dev:dcorp": "npm run dev --workspace @grupo-patrimonial/dcorp -- --port 3002",
    "dev:dashboard": "npm run dev --workspace @grupo-patrimonial/dashboard -- --port 3000",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "build:rendal": "npm run build --workspace @grupo-patrimonial/rendal",
    "build:dcorp": "npm run build --workspace @grupo-patrimonial/dcorp",
    "build:dashboard": "npm run build --workspace @grupo-patrimonial/dashboard"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@marsidev/react-turnstile": "^1.6.1",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.17",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/postprocessing": "^3.0.4",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@upstash/ratelimit": "^2.1.0",
    "@upstash/redis": "^1.38.4",
    "@vercel/blob": "^2.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.577.0",
    "next": "15.5.13",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "resend": "^6.9.4",
    "shadcn": "^4.0.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "three": "^0.183.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.13",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
