# Copie para .env.local e preencha. Nunca commite segredos.

# --- Resend (envio do formulário) ---
RESEND_API_KEY="re_xxxxxxxx"

# Caixas humanas (Workspace / encaminhamento). Sem MX ainda, o envio falha ou fica em bounce.
CONTACT_EMAIL_RENDAL="contato@gruporendal.com.br"
CONTACT_EMAIL_DCORP="contato@dcorp.com.br"

# Remetentes autenticados no Resend (verificar cada domínio no painel).
RESEND_FROM_RENDAL="Grupo Rendal <noreply@gruporendal.com.br>"
RESEND_FROM_DCORP="DCorp Engenharia <noreply@dcorp.com.br>"

# --- Cloudflare Turnstile ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# --- Upstash Redis (rate limit) ---
UPSTASH_REDIS_REST_URL="https://xxxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxxxx"

# --- Site / empresas ---
NEXT_PUBLIC_CNPJ_RENDAL=""
NEXT_PUBLIC_CNPJ_DCORP="55085352000189"
NEXT_PUBLIC_WHATSAPP_RENDAL="5519999999999"
NEXT_PUBLIC_WHATSAPP_DCORP="5519993670722"

# --- Admin / storage ---
ADMIN_PASSWORD="change-me"
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxx"

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
